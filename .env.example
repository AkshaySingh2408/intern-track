# ==========================================
# InternTrack Environment Configuration
# ==========================================

# 1. Database Configuration (MySQL for Production & Docker)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DATABASE=interntrack

# Full Database Connection URL:
# For MySQL:
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/interntrack?charset=utf8mb4
# For SQLite local fallback:
# DATABASE_URL=sqlite:///./interntrack.db

# 2. JWT & Security Settings
SECRET_KEY=change_this_to_a_random_cryptographically_secure_string_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. Backend Server
PORT=8000
ENVIRONMENT=development

# 4. Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
