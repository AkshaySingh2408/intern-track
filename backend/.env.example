# Database Configuration (MySQL)
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=interntrack

# Full Database URL (Overrides separate parameters if provided)
# For MySQL:
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/interntrack?charset=utf8mb4
# For SQLite local fallback:
# DATABASE_URL=sqlite:///./interntrack.db

# JWT Authentication
SECRET_KEY=interntrack_super_secure_jwt_secret_key_2026_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Server Configuration
PORT=8000
ENVIRONMENT=production
